# InstaT — variáveis de ambiente (copie para .env; .env está no .gitignore)
# Roadmap: docs/ROADMAP_MOBILE.md

# --- DataImpulse (proxy móvel sticky) — roadmap §1.3 ---
# NUNCA comitar credenciais reais. gw.dataimpulse.com:823 (rotativo),
# 10000-20000 (sticky). Parâmetros no usuário: __cr.br;asn.<n>;sessid.<id>;sessttl.<min>
DATAIMPULSE_LOGIN=
DATAIMPULSE_PASSWORD=
DATAIMPULSE_GATEWAY=gw.dataimpulse.com

# --- Contas de teste dedicadas (nunca contas de terceiros) — roadmap §2 ---
# Uma conta por slot. Formato sugerido: user:pass separados por vírgula.
INSTAT_TEST_ACCOUNTS=

# --- Container Android (Fase 1) ---
# Host do adb do container (redroid/budtmo). Ex.: 127.0.0.1:5555
INSTAT_ADB_HOST=127.0.0.1:5555
# redroid GPU: auto | host | guest (guest = software, fallback estável) — §1.2
INSTAT_REDROID_GPU_MODE=guest
